<Window x:Class="SistemaEstoqueWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Integração de Estoque - Adapter + MVVM" Height="350" Width="550"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Importar Produtos do ERP Antigo (MVVM)" 
                Command="{Binding ImportarCommand}" 
                Padding="10" Margin="0,0,0,15"
                FontSize="14" FontWeight="Bold"
                Background="#007ACC" Foreground="White" Cursor="Hand"/>

        <DataGrid Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                  AlternatingRowBackground="#FFE5E5E5" HeadersVisibility="Column"
                  FontSize="14" ItemsSource="{Binding Produtos}"/>
    </Grid>
</Window>